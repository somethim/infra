#!/usr/bin/env python3
"""Refuse a release's compose model that could reach past its stack.

    python3 -I infra-compose-guard <model.json> <stack_dir> <stack> [--tailscale-ip=<IPv4>]
        [--service-user=<uid>:<gid>] [<app image repository>...]

<model.json> is `docker compose config --no-env-resolution --format json` for
<stack_dir>/docker-compose.yml; <stack> is database, portfolio, hypernova,
tunnel, ai or media; the repositories are the app images /etc/infra/host.env allows for
that stack (none for the others, whose images must be digest-pinned).
--tailscale-ip is the host's Tailscale IPv4 (TAILSCALE_IP in host.env): the
only address a port may be published on, and only by the services TAILNET_PORTS
names, as "${TAILSCALE_IP}:<port>:<port>". --service-user is the account the
host made for a hardened stack (ai, media): every service there runs as it,
with a mem_limit, cap_drop ALL and no-new-privileges. Bind mounts: only the
BIND_MOUNTS folders (the library folders under /srv/media, Garage's /srv/media/s3,
and the two folders Beszel's agent reads disk sizes through), each at its fixed
target, read-only except Audiobookshelf's audiobooks and podcasts and Garage's s3.
infra-apply runs this on every stack of a bundle before anything changes.
Prints one summary line on success; prints `docker-compose.yml: <reason>` and
exits 1 on a refusal. Installed as /usr/local/libexec/infra-compose-guard.
"""
import json
import os
import re
import sys

