SERVICE_FIELDS = {
    "command", "container_name", "cpus", "depends_on", "entrypoint", "env_file",
    "environment", "extra_hosts", "healthcheck", "image", "labels", "mem_limit", "networks",
    "restart", "stop_grace_period", "stop_signal", "volumes", "profiles",
    "user", "security_opt", "cap_drop", "read_only", "init", "working_dir", "tmpfs",
    "ports", "deploy",
}
FIELD_REASONS = {
    "privileged": "which gives it root on the host",
    "cap_add": "which adds kernel capabilities",
    "devices": "which passes host devices into it",
    "device_cgroup_rules": "which opens host devices to it",
    "gpus": "which passes host devices into it",
    "sysctls": "which changes kernel parameters",
    "cgroup_parent": "which places it outside the stack's cgroup",
    "cgroup": "which can share the host's cgroup namespace",
    "uts": "which shares the host's UTS namespace",
    "userns_mode": "which turns off user namespace remapping",
    "runtime": "which picks another container runtime",
    "use_api_socket": "which hands it the Docker socket",
    "volumes_from": "which mounts another container's volumes",
    "build": "which builds an image from files on the host",
    "label_file": "which reads a file on the host",
}
# Refused unless TAILNET_PORTS or GPU_SERVICES name the service (checked separately).
GATED_FIELDS = {
    "ports": "which publishes a host port past the firewall",
    "deploy": "which can reserve host devices",
}
PORT_FIELDS = {"mode", "host_ip", "target", "published", "protocol"}
BIND_FIELDS = {"type", "source", "target", "read_only", "bind"}
NETWORK_FIELDS = {"name", "external", "ipam", "labels"}
SAFE_SECURITY_OPTS = {"no-new-privileges", "no-new-privileges:true", "no-new-privileges=true"}
PINNED = re.compile(r"^[a-z0-9./_-]+:[A-Za-z0-9._-]+@sha256:[0-9a-f]{64}$")


def refuse(reason):
    print("docker-compose.yml: " + reason)
    sys.exit(1)


def show(value):
    return json.dumps(value)


def repository(ref):
    ref = ref.split("@", 1)[0]
    head, _, last = ref.rpartition("/")
    if ":" in last:
        last = last.rsplit(":", 1)[0]
    return (head + "/" if head else "") + last


def raw_lines(path):
    """Yield (indent, text) for the non-comment lines of a YAML file."""
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except OSError:
        return
    for line in lines:
        text = line.split(" #", 1)[0].rstrip()
        if not text.strip() or text.lstrip().startswith("#"):
            continue
        yield len(text) - len(text.lstrip(" ")), text.strip()


def raw_checks(path, stack, raw_ports, raw_binds):
    """Refuse what `compose config` resolves away before the model shows it.

    Yields (service, env_file) pairs, and records each service's ports items,
    as written, in raw_ports, and how each bind mount is written in raw_binds:
    (service, source) -> "short", or the long form's create_host_path value
    ("false", "true" or "absent")."""
    top = service = None
    block = None
    ports_block = None
    volumes_block = None
    long_mount = None
    for indent, stripped in raw_lines(path):
        key = stripped[2:] if stripped.startswith("- ") else stripped
        if volumes_block is not None:
            if indent > volumes_block:
                if stripped.startswith("- ") and indent == volumes_block + 2:
                    long_mount = None
                    if key.startswith("type:"):
                        long_mount = {"source": None, "chp": "absent"}
                    elif ":" in key and not key.endswith(":"):
                        raw_binds[(service, key.strip("'\"").split(":", 1)[0])] = "short"
                        continue
                if long_mount is not None:
                    field, _, value = key.partition(":")
                    field, value = field.strip(), value.strip().strip("'\"")
                    if field == "source":
                        long_mount["source"] = value
                    elif field == "create_host_path":
                        long_mount["chp"] = value.lower()
                    if long_mount["source"]:
                        raw_binds[(service, long_mount["source"])] = long_mount["chp"]
                continue
            volumes_block = long_mount = None
        if "<<" in key.split(":", 1)[0] and ":" in key:
            refuse("uses a YAML merge key (<<), which can pull settings from elsewhere")
        if indent == 0 and stripped.split(":", 1)[0] == "include":
            refuse("includes another compose file")
        if ports_block is not None:
            if indent > ports_block:
                if not stripped.startswith("- "):
                    refuse(f"service {service} writes ports in a form other than a list of \"{TAILNET_PORT_FORM.format(port='<port>')}\" strings")
                raw_ports.setdefault(service, []).append(stripped[2:].strip().strip("'\""))
                continue
            ports_block = None
        if block is not None:
            if indent > block:
                item = key[5:].strip() if key.startswith("path:") else key
                if stripped.startswith("- ") or key.startswith("path:"):
                    yield service, item.strip("'\"")
                continue
            block = None
        if indent == 0 and stripped.endswith(":"):
            top, service = stripped[:-1], None
            continue
        if top == "services" and indent == 2 and stripped.endswith(":"):
            service = stripped[:-1].strip("'\"")
            continue
        if top == "services" and service and indent == 4 and ":" in stripped and not stripped.startswith("- "):
            field, _, value = stripped.partition(":")
            field = field.strip("'\"")
            if field == "extends":
                refuse(f"service {service} extends another service, which can pull settings from another file")
            if field == "profiles":
                refuse(f"service {service} sets profiles, which hides it from the checked model")
            if field in FIELD_REASONS:
                refuse(f"service {service} sets {field}, {FIELD_REASONS[field]}")
            if field == "ports":
                if (stack, service) not in TAILNET_PORTS:
                    refuse(f"service {service} sets ports, {GATED_FIELDS['ports']}")
                if value.strip():
                    refuse(f"service {service} writes ports in a form other than a list of \"{TAILNET_PORT_FORM.format(port='<port>')}\" strings")
                raw_ports.setdefault(service, [])
                ports_block = indent
            if field == "volumes" and not value.strip():
                volumes_block = indent
            if field == "env_file":
                value = value.strip()
                if not value:
                    block = indent
                elif value.startswith("["):
                    for item in value.strip("[]").split(","):
                        if item.strip():
                            yield service, item.strip().strip("'\"")
                else:
                    yield service, value.strip("'\"")


def env_keys(path):
    keys = set()
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    keys.add(line.split("=", 1)[0].strip())
    except OSError:
        pass
    return keys


def usage():
    print("usage: infra-compose-guard <model.json> <stack_dir> " + "|".join(STACKS)
          + " [--tailscale-ip=<IPv4>] [--service-user=<uid>:<gid>] [<app image repository>...]")
    sys.exit(64)


def check_ports(stack, name, spec, raw_ports, tailscale_ip):
    """The service publishes exactly its TAILNET_PORTS port, on the tailnet address, written as the form."""
    port = TAILNET_PORTS.get((stack, name))
    ports = spec.get("ports")
    if port is None:
        if ports:
            refuse(f"service {name} sets ports, {GATED_FIELDS['ports']}")
        return None
    want = TAILNET_PORT_FORM.format(port=port)
    if raw_ports.get(name) != [want]:
        refuse(f"service {name} publishes {show(raw_ports.get(name, []))}; it may publish exactly [\"{want}\"]")
    if not tailscale_ip:
        refuse(f"service {name} publishes {port} on the tailnet, but no Tailscale address was given (TAILSCALE_IP in /etc/infra/host.env; run provisioning)")
    if not isinstance(ports, list) or len(ports) != 1 or not isinstance(ports[0], dict):
        refuse(f"service {name} publishes {show(ports)}; it may publish exactly {port} on {tailscale_ip}")
    entry = ports[0]
    for field in sorted(entry):
        if field not in PORT_FIELDS:
            refuse(f"service {name} sets ports.{field}, which a release may not set")
    if (entry.get("host_ip") != tailscale_ip or entry.get("target") != port or str(entry.get("published")) != str(port)
            or entry.get("protocol", "tcp") != "tcp" or entry.get("mode", "ingress") != "ingress"):
        refuse(f"service {name} publishes {show(entry)}; it may publish exactly tcp {port} on {tailscale_ip}, the host's Tailscale address")
    return f"{name} {tailscale_ip}:{port}"


def check_deploy(stack, name, spec):
    """Only GPU_SERVICES reserve a device, and only the whole NVIDIA GPU."""
    deploy = spec.get("deploy")
    if deploy is None:
        return False
    if (stack, name) not in GPU_SERVICES:
        refuse(f"service {name} sets deploy, {GATED_FIELDS['deploy']}; only {', '.join(sorted(s for _, s in GPU_SERVICES))} may reserve the GPU")
    try:
        extra = {k: v for k, v in deploy.items() if k not in {"resources", "placement"}}
        reservations = deploy["resources"]["reservations"]
        devices = reservations["devices"]
        shape_ok = (not extra and deploy.get("placement", {}) == {} and set(deploy["resources"]) == {"reservations"}
                    and set(reservations) == {"devices"} and isinstance(devices, list) and len(devices) == 1)
        device = dict(devices[0]) if shape_ok else {}
    except (AttributeError, KeyError, TypeError):
        shape_ok, device = False, {}
    if device.get("count") == "all":
        device["count"] = -1
    if not shape_ok or device != GPU_DEVICE:
        refuse(f"service {name} sets deploy {show(deploy)}; it may only reserve all NVIDIA GPUs (driver nvidia, count all, capabilities [gpu])")
    return True


def check_mounts(stack, name, spec, raw_binds):
    """Named volumes and tmpfs only, plus the BIND_MOUNTS this service may have."""
    allowed = BIND_MOUNTS.get((stack, name), {})
    binds = []
    for mount in spec.get("volumes") or []:
        kind = mount.get("type") if isinstance(mount, dict) else None
        if kind in {"volume", "tmpfs"}:
            continue
        source = str(mount.get("source", "")) if isinstance(mount, dict) else str(mount)
        if "docker.sock" in source:
            refuse(f"service {name} mounts the Docker socket {show(source)}")
        if kind != "bind" or source not in allowed:
            refuse(f"service {name} has a {show(kind)} mount of {show(source)}; a release may only use its named volumes and tmpfs"
                   + (f", and {', '.join(sorted(allowed))}" if allowed else ""))
        target, read_only = allowed[source]
        for field in sorted(mount):
            if field not in BIND_FIELDS:
                refuse(f"service {name} sets {field} on its mount of {source}, which a release may not set")
        # Compose builds differ in how they render create_host_path: false (some print
        # {"create_host_path": false}, some drop it to {}), and the short syntax also
        # renders as {} while meaning true. So the file as written decides: only the long
        # form with create_host_path: false passes.
        written = raw_binds.get((name, source))
        bind_ok = mount.get("bind") == {"create_host_path": False} or (mount.get("bind") in ({}, None) and written == "false")
        if written == "short":
            bind_ok = False
        if mount.get("target") != target or bool(mount.get("read_only")) != read_only or not bind_ok:
            refuse(f"service {name} mounts {source} as {show({k: mount.get(k) for k in ('target', 'read_only', 'bind')})}; it may only mount it at "
                   f"{target}{' read-only' if read_only else ''}, with bind.create_host_path: false")
        binds.append(f"{source}{' (ro)' if read_only else ''}")
    return binds


def check_hardened(name, spec, service_user):
    """A hardened stack's services run as the host's service account, bounded and with no privileges."""
    if not service_user:
        refuse(f"service {name} is in a hardened stack, but no service account was given (run provisioning)")
    if str(spec.get("user", "")) != service_user:
        refuse(f"service {name} runs as {show(spec.get('user'))}; it must run as {service_user}, the account /etc/infra/host.env names")
    if not spec.get("mem_limit"):
        refuse(f"service {name} sets no mem_limit")
    if "ALL" not in [str(c).upper() for c in spec.get("cap_drop") or []]:
        refuse(f"service {name} does not drop every capability (cap_drop: [ALL])")
    if not any(str(o) in SAFE_SECURITY_OPTS for o in spec.get("security_opt") or []):
        refuse(f"service {name} does not set security_opt no-new-privileges")


def main():
    if len(sys.argv) < 4 or sys.argv[3] not in STACKS:
        usage()
    model_path, project, stack = sys.argv[1], os.path.normpath(sys.argv[2]), sys.argv[3]
    tailscale_ip = service_user = None
    app_repos = set()
    for arg in sys.argv[4:]:
        if arg.startswith("--tailscale-ip="):
            tailscale_ip = arg.split("=", 1)[1]
            if not TAILSCALE_IPV4.match(tailscale_ip):
                refuse(f"the Tailscale address {show(tailscale_ip)} is not an IPv4 address in 100.64.0.0/10")
        elif arg.startswith("--service-user="):
            service_user = arg.split("=", 1)[1]
            uid, _, gid = service_user.partition(":")
            if not (uid.isdigit() and gid.isdigit() and int(uid) > 0 and int(gid) > 0):
                refuse(f"the service account {show(service_user)} is not <uid>:<gid> of an account other than root")
        elif arg.startswith("--"):
            usage()
        else:
            app_repos.add(arg)
    spec_for = STACKS[stack]
    bundle_env_files = {os.path.join(project, name) for name in spec_for["env_files"]}
    allowed_env_list = ", ".join(spec_for["env_files"]) or "no env file"

    raw_ports = {}
    raw_binds = {}
    # Env files per service as written; some Compose builds resolve env_file into
    # environment and drop it from the model, so the file as written is checked too.
    raw_env_files = {}
    entries = sorted(os.listdir(project)) if os.path.isdir(project) else []
    for entry in entries:
        if entry.endswith((".yml", ".yaml")):
            for service_name, raw in raw_checks(os.path.join(project, entry), stack, raw_ports, raw_binds):
                resolved = os.path.normpath(raw if os.path.isabs(raw) else os.path.join(project, raw))
                raw_env_files.setdefault(service_name, set()).add(resolved)
                if resolved not in bundle_env_files:
                    refuse(f"service {service_name or '?'} reads env_file {show(raw)}; the {stack} stack may only read {allowed_env_list} from the bundle")

    # Keys a service could only have from an env file the stack may not read
    # (the interpolation file .env and the stack's own env file are fine).
    allowed_keys = set().union(*(env_keys(path) for path in bundle_env_files | {os.path.join(project, ".env")}))
    foreign_env_keys = {}
    for entry in entries:
        path = os.path.join(project, entry)
        if entry.endswith(".env") and entry != ".env" and path not in bundle_env_files and os.path.isfile(path):
            for key in env_keys(path) - allowed_keys:
                foreign_env_keys.setdefault(key, path)

    try:
        with open(model_path, encoding="utf-8") as handle:
            model = json.load(handle)
    except (OSError, ValueError):
        refuse("docker compose config did not print a readable model")
    if not isinstance(model, dict):
        refuse("docker compose config did not print a readable model")

    for key in sorted(model):
        if key not in {"name", "services", "networks", "volumes"}:
            refuse(f"the top-level {key} is not something a release may set")
    if model.get("name") != stack:
        refuse(f"the project name is {show(model.get('name'))}, not {stack}")

    services = model.get("services") or {}
    networks = model.get("networks") or {}
    volumes = model.get("volumes") or {}
    if not services:
        refuse("the stack has no services")

    for key, spec in sorted(networks.items()):
        spec = spec or {}
        for field in sorted(spec):
            if field not in NETWORK_FIELDS:
                refuse(f"network {key} sets {field}, which a release may not set")
        name = spec.get("name", "")
        if not spec.get("external") or name not in spec_for["networks"]:
            allowed = " and ".join(sorted(spec_for["networks"]))
            refuse(f"network {key} is {show(name)}{'' if spec.get('external') else ' and not external'}; the {stack} stack may only join the existing network(s) {allowed}")

    if set(volumes) != set(spec_for["volumes"]):
        refuse(f"the volumes are {show(sorted(volumes))}; the {stack} stack uses exactly {show(sorted(spec_for['volumes']))}")
    for key, spec in sorted(volumes.items()):
        spec = spec or {}
        want = spec_for["volumes"][key]
        for field in sorted(spec):
            if field == "driver_opts":
                refuse(f"volume {key} sets driver_opts, which can mount a host path")
            if field not in {"name", "external", "labels"}:
                refuse(f"volume {key} sets {field}, which a release may not set")
        if spec.get("name") != want["name"] or bool(spec.get("external")) != want["external"]:
            refuse(f"volume {key} is {show(spec.get('name'))}{' (external)' if spec.get('external') else ''}; the {stack} stack keeps its data in {show(want['name'])}{' (external)' if want['external'] else ''}")

    published, gpus, binds = [], [], []
    container_networks = spec_for.get("container_networks")
    container_env_files = spec_for.get("container_env_files")
    for name, spec in sorted(services.items()):
        for field in sorted(spec):
            if field not in SERVICE_FIELDS:
                refuse(f"service {name} sets {field}, {FIELD_REASONS.get(field, 'which a release may not set')}")
        container_name = spec.get("container_name")
        if container_name not in spec_for["containers"]:
            refuse(f"service {name} sets container_name {show(container_name)}; the {stack} stack names its containers {' or '.join(sorted(spec_for['containers']))}")
        if spec_for.get("hardened") and name != container_name:
            refuse(f"service {name} names its container {show(container_name)}; in the {stack} stack a service is named after its container")
        if container_networks is not None:
            joined = set(spec.get("networks") or {})
            names = {str((networks.get(key) or {}).get("name", key)) for key in joined}
            extra = names - container_networks.get(container_name, set())
            if extra:
                refuse(f"service {name} joins {', '.join(sorted(extra))}; {container_name} may only join {', '.join(sorted(container_networks.get(container_name, set()))) or 'no network'}")
        if container_env_files is not None:
            mine = {os.path.join(project, f) for f in container_env_files.get(container_name, set())}
            paths = {os.path.normpath(str(entry.get("path") if isinstance(entry, dict) else entry)) for entry in spec.get("env_file") or []}
            for path in sorted(paths | raw_env_files.get(name, set())):
                if path not in mine:
                    readers = ", ".join(sorted(container_env_files)) or "no service"
                    refuse(f"service {name} reads env_file {show(path)}; in the {stack} stack {readers} may read an env file, each its own")
        if spec_for.get("hardened"):
            check_hardened(name, spec, service_user)
        port = check_ports(stack, name, spec, raw_ports, tailscale_ip)
        if port:
            published.append(port)
        if check_deploy(stack, name, spec):
            gpus.append(name)
        binds += [f"{name} {b}" for b in check_mounts(stack, name, spec, raw_binds)]
        user = spec.get("user")
        if user is not None:
            uid = str(user).split(":", 1)[0].strip()
            if uid in {"", "root"} or (uid.isdigit() and int(uid) == 0):
                refuse(f"service {name} sets user {show(user)}; a release may not name root")
        for option in spec.get("security_opt") or []:
            if str(option) not in SAFE_SECURITY_OPTS:
                refuse(f"service {name} sets security_opt {show(option)}; a release may only add no-new-privileges")
        image = str(spec.get("image", ""))
        if repository(image) in app_repos:
            pass
        elif not PINNED.match(image):
            refuse(f"service {name} runs {show(image)}, which is neither an app image from /etc/infra/host.env nor pinned to a tag and a digest")
        for entry in spec.get("env_file") or []:
            path = entry.get("path") if isinstance(entry, dict) else entry
            if os.path.normpath(str(path)) not in bundle_env_files:
                refuse(f"service {name} reads env_file {show(path)}; the {stack} stack may only read {allowed_env_list} from the bundle")
        environment = spec.get("environment") or {}
        keys = environment.keys() if isinstance(environment, dict) else [str(item).split("=", 1)[0] for item in environment]
        for key in sorted(keys):
            if key in foreign_env_keys:
                refuse(f"service {name} reads env_file {show(foreign_env_keys[key])}; the {stack} stack may only read {allowed_env_list} from the bundle")
        labels = spec.get("labels") or {}
        labels = labels.keys() if isinstance(labels, dict) else [str(item).split("=", 1)[0] for item in labels]
        allowed_labels = spec_for["labels"]
        for label in sorted(labels):
            if HOST_LABELS.match(label) and not (allowed_labels and allowed_labels.match(label)):
                role = "is never routed or auto-updated" if allowed_labels else "is never routed, auto-updated or auto-healed"
                refuse(f"service {name} sets the label {label}; the {stack} stack {role}")

    for name in sorted(raw_ports):
        if name not in services:
            refuse(f"service {name} publishes ports the checked model does not show")
    summary = f"{len(services)} service(s) in the {stack} stack, no privileged settings"
    if published or gpus or binds:
        summary += (f", no host port but {', '.join(published) or 'none'} on the tailnet, no bind mount but {', '.join(binds) or 'none'}, "
                    f"the GPU only for {', '.join(gpus) or 'none'}, no Docker socket")
    else:
        summary += ", host ports, bind mounts or Docker socket"
    print(summary)


main()
