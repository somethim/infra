[Unit]
Description=Keep the CI runners' container on the internet and off the tailnet, the LAN and Docker
After=docker.service infra-firewall.service incus.service
Requires=docker.service infra-firewall.service
PartOf=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/ci-runners-firewall
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ci-runners-firewall

[Install]
WantedBy=multi-user.target docker.service
