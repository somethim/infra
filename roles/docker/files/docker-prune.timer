[Unit]
Description=Weekly reclaim of dangling Docker images

[Timer]
# Ahead of the 04:00 unattended-upgrades reboot window, and the jitter keeps it there.
OnCalendar=Sun 03:00
RandomizedDelaySec=30m
# Catch up after a reboot rather than skipping the week.
Persistent=true

[Install]
WantedBy=timers.target
