[Unit]
Description=Reclaim Docker images no container uses, older than a week
Documentation=https://docs.docker.com/reference/cli/docker/image/prune/

[Service]
Type=oneshot
# Every image no container uses whose creation time is more than 168 h ago.
# `until` filters by image creation time, not by when it stopped being used, so
# this keeps a replaced app image only while it is young. That local copy is a
# best-effort extra source of a previous digest for rollback; the primary source
# is each release's running-images.env (plans/004).
#
# Deliberately not pruning containers: `docker container prune` would delete a
# stopped-on-purpose container, and Watchtower gets stopped by hand during a cutover.
ExecStart=/usr/bin/docker image prune --all --force --filter until=168h
