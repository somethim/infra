{# Rendered by release.yml into the bundle as media/.env (0600). Compose reads
   it only for interpolation in docker-compose.yml: the account every container
   runs as (roles/host creates it with this uid and gid and owns the library
   with it). No secrets here. TAILSCALE_IP is not here: infra-apply exports it
   from /etc/infra/host.env. #}
MEDIA_UID={{ media_uid }}
MEDIA_GID={{ media_gid }}
