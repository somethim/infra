{# Rendered by release.yml into the bundle as media/.env (0600). Compose reads
   it only for interpolation in docker-compose.yml: the account every container
   runs as (roles/host creates it with this uid and gid and owns the library
   with it), the links page's name, each tailnet service's https name under it
   (production.yml's home_hosts) and the certificate's ACME contact (home-tls), and the status dashboard's login name (beszel). No secrets here. TAILSCALE_IP is not here: infra-apply exports it
   from /etc/infra/host.env. #}
MEDIA_UID={{ media_uid }}
MEDIA_GID={{ media_gid }}
HOME_DOMAIN={{ home_domain }}
{% for key in ['ai', 'photos', 'jellyfin', 'audiobooks', 'books', 'files', 'status', 's3'] %}
HOST_{{ key | upper }}={{ home_hosts[key] }}.{{ home_domain }}
{% endfor %}
ACME_EMAIL={{ acme_email }}
STATUS_OWNER_EMAIL={{ status_owner_email }}
