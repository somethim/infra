{# Rendered by release.yml into the bundle as media/sftpgo.env (0600). Read
   only by sftpgo: the owner's file-manager password (FILES_PASSWORD) and the
   owner's S3 key it reaches the files bucket in Garage with. See docs/stacks.md. #}
FILES_PASSWORD={{ files_password }}
S3_ACCESS_KEY_ID={{ garage_owner_access_key_id }}
S3_SECRET_ACCESS_KEY={{ garage_owner_secret_key }}
