{# Rendered by release.yml into the bundle as ai/.env (0600). Compose reads it
   only for interpolation in docker-compose.yml: the account the containers run
   as (roles/host creates it with this uid and gid) and the model ollama-pull
   fetches. No secrets here. TAILSCALE_IP is not here: infra-apply exports it
   from /etc/infra/host.env. #}
AI_UID={{ ai_uid }}
AI_GID={{ ai_gid }}
OLLAMA_MODEL={{ ollama_model }}
