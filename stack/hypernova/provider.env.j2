{# Rendered by release.yml into the bundle as hypernova/provider.env (0600).
   Only the prizm-provider container reads it. See docs/stacks.md. #}
PORT=8080
WEB_ORIGIN=https://hypernova.arbikullakshi.com
DATABASE_URL=postgres://prizm:{{ prizm_db_password | urlencode | replace('/', '%2F') }}@postgresql:5432/prizm
STORAGE_PATH=/app/storage
SESSION_SECRET={{ hypernova_session_secret }}
ADMIN_USERNAME=admin
ADMIN_PASSWORD={{ hypernova_admin_password }}
AI_DISABLED=false
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL={{ hypernova_ollama_model }}
VAT_RATE=0.20
LABOR_RATE=15
DAY_THRESHOLD=8
