{# Rendered by release.yml into the bundle as database/provision.sql (0600).
   infra-apply feeds it to `docker exec -i postgresql psql -v ON_ERROR_STOP=1
   -U postgres -d postgres` once the database is healthy and before the app
   stacks start. Every statement is guarded, so it is safe on every release.
   The passwords are literal: release.yml only accepts [A-Za-z0-9]{32,}.
   See docs/database.md, Roles and databases. #}
ALTER ROLE postgres WITH SUPERUSER LOGIN PASSWORD '{{ postgres_superuser_password }}';
{% for consumer in [{'name': 'prizm', 'password': prizm_db_password}, {'name': 'portfolio', 'password': portfolio_db_password}] %}

SELECT 'CREATE ROLE {{ consumer.name }} LOGIN'
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ consumer.name }}')\gexec

ALTER ROLE {{ consumer.name }} WITH LOGIN PASSWORD '{{ consumer.password }}';

SELECT 'ALTER ROLE {{ consumer.name }} WITH NOSUPERUSER NOCREATEDB NOCREATEROLE'
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ consumer.name }}' AND oid = 10)\gexec

SELECT 'CREATE DATABASE {{ consumer.name }} OWNER {{ consumer.name }}'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '{{ consumer.name }}')\gexec

ALTER DATABASE {{ consumer.name }} OWNER TO {{ consumer.name }};
REVOKE CONNECT ON DATABASE {{ consumer.name }} FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE {{ consumer.name }} TO {{ consumer.name }};
{% endfor %}
