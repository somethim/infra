# Rendered by Ansible to /opt/portfolio/.env. Read by docker compose for the few
# values it interpolates AND injected wholesale into portfolio-web via
# `env_file`. Non-secrets are literal; secrets come from the deploy workflow.
#
# The legacy container reads nothing from here.

# ── Images (pinned to moving tags so Watchtower follows them) ────────────────
PORTFOLIO_IMAGE=ghcr.io/somethim/portfolio:latest
PORTFOLIO_LEGACY_IMAGE=ghcr.io/somethim/portfolio:legacy

# ── Routing ──────────────────────────────────────────────────────────────────
APEX_DOMAIN=arbikullakshi.com
WWW_DOMAIN=www.arbikullakshi.com
LEGACY_DOMAIN=legacy.arbikullakshi.com

# ── Database ─────────────────────────────────────────────────────────────────
# The shared PostgreSQL on the crm stack, reached over the `data` network with
# the portfolio's own role and database (created by roles/portfolio-db). The
# password is URL-encoded, '/' included, so no character can corrupt the DSN.
DATABASE_URL=postgres://portfolio:{{ portfolio_db_password | urlencode | replace('/', '%2F') }}@postgresql:5432/portfolio

# ── Server ───────────────────────────────────────────────────────────────────
# Passkeys are bound to this origin: change it and every enrolled credential
# stops working. It is also the base for links in outgoing email.
WEBAUTHN_ORIGIN=https://arbikullakshi.com
# One trusted hop — the edge Traefik — so the visitor's address is the rightmost
# entry of X-Forwarded-For. This keys the rate limiter; with the default
# (ConnectInfo) every visitor would share Traefik's bucket.
CLIENT_IP_SOURCE=RightmostForwardedFor:1

# ── Operator account ─────────────────────────────────────────────────────────
# Created on the first boot against an empty database and left alone after that;
# the site has no signup path, so without this nobody can sign in. Changing the
# password here does NOT change it on an existing account — do that in /admin.
ADMIN_EMAIL=contact@arbikullakshi.com
ADMIN_PASSWORD={{ portfolio_admin_password }}

# ── Mail (Resend) ────────────────────────────────────────────────────────────
# Without a key the site still runs: contact messages and comments are recorded
# and only the notifications about them are skipped and logged. The From domain
# must be verified in Resend or every send is rejected.
RESEND_API_KEY={{ portfolio_resend_api_key | default('') }}
RESEND_FROM=Arbi Kullakshi <contact@arbikullakshi.com>
OWNER_INBOX=contact@arbikullakshi.com
