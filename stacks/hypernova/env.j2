# Rendered by Ansible → /opt/hypernova/.env. Read by docker compose for interpolation AND
# injected into the provider container via `env_file: .env`. Non-secrets are literal;
# secret values are filled from the infra deploy workflow (CI variables).

# ── Images (pinned to :latest so Watchtower follows the moving tag) ──────────
PROVIDER_IMAGE=ghcr.io/hypernova3643725/hypernova-provider:latest
WEB_IMAGE=ghcr.io/hypernova3643725/hypernova-web:latest

# ── Routing (web at /, provider API at /api on the same host) ────────────────
WEB_DOMAIN=hypernova.arbikullakshi.com

# ── Provider runtime ─────────────────────────────────────────────────────────
PORT=8080
WEB_ORIGIN=https://hypernova.arbikullakshi.com
# Shared Postgres on the CRM stack: connect to crm-pgsql over the `data` network using
# hypernova's own prizm role + database. The password is the SAME secret CRM uses to
# create the role (prizm_db_password) — one value, no drift. The password is URL-encoded
# here (incl. '/') so special chars can't corrupt the DSN; postgres-js decodes it back to
# the raw value, which matches the role created by CRM's initdb.
DATABASE_URL=postgres://prizm:{{ prizm_db_password | urlencode | replace('/', '%2F') }}@crm-pgsql:5432/prizm
STORAGE_PATH=/app/storage
SESSION_SECRET={{ hypernova_session_secret }}
ADMIN_USERNAME=admin
ADMIN_PASSWORD={{ hypernova_admin_password }}

# AI disabled on this deployment (no Ollama on the host).
AI_DISABLED=true
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2:3b

# Quotation tuning
VAT_RATE=0.20
LABOR_RATE=15
DAY_THRESHOLD=8
