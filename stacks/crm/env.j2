# Rendered by Ansible → /opt/crm/.env. Read by docker compose for interpolation AND
# injected into the app/worker containers via `env_file: .env`. Non-secrets are literal;
# secret values are filled from the infra deploy workflow (CI variables).

# ── Images (pinned to :latest so Watchtower follows the moving tag) ──────────
PROVIDER_IMAGE=ghcr.io/somethim/crm-provider:latest
WEB_IMAGE=ghcr.io/somethim/crm-web:latest

# ── Routing ──────────────────────────────────────────────────────────────────
WEB_DOMAIN=crm.arbikullakshi.com

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=CRM
APP_ENV=production
APP_KEY={{ crm_app_key }}
APP_DEBUG=false
APP_URL=https://crm.arbikullakshi.com
APP_PORT=8080
APP_TIMEZONE=UTC
FRONTEND_URL=https://crm.arbikullakshi.com
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ── Seeded admin ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD={{ crm_admin_password }}

# ── Database — Postgres ──────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD={{ crm_db_password }}
DB_SSLMODE=disable
# Used once by initdb to create hypernova's role + database (shared instance).
PRIZM_DB_PASSWORD={{ prizm_db_password }}

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ crm_redis_password }}
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# ── Cache / Session / Queue — Redis ──────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=crm.arbikullakshi.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=crm.arbikullakshi.com
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_FAILED_DATABASE=pgsql
QUEUE_BATCHING_DATABASE=pgsql

FILESYSTEM_DISK=local

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@arbikullakshi.com
MAIL_FROM_NAME=CRM

# ── Search — Typesense ───────────────────────────────────────────────────────
SCOUT_DRIVER=typesense
TYPESENSE_API_KEY={{ crm_typesense_api_key }}
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
